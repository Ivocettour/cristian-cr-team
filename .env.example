# Copiá este archivo a .env.local y completá con los datos de tu proyecto Supabase
# (Project Settings > API en el dashboard de Supabase).

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Service role key (Project Settings > API > service_role) — SOLO server-side.
# Necesaria para el fan-out de notificaciones (leer seguidores/suscripciones
# push de otros usuarios). Nunca se expone al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Claves VAPID para Web Push. Generalas vos con:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=tu-vapid-public-key
VAPID_PRIVATE_KEY=tu-vapid-private-key
VAPID_SUBJECT=mailto:tu-email@ejemplo.com
